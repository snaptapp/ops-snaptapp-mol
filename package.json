{
  "dependencies": {
    "@amplitude/analytics-browser": "^2.47.4",
    "@cloudflare/vite-plugin": "^1.25.5",
    "@lovable.dev/cloud-auth-js": "^1.2.0",
    "@lovable.dev/mcp-js": "^3.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "date-fns": "^4.1.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "use-webmcp-tool": "^0.3.0",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-plugin-dev-server-bridge": "^1.0.2",
    "@lovable.dev/vite-plugin-hmr-gate": "^1.8.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "0.x",
    "drizzle-orm": "0.x",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-check": "4.10.1",
    "globals": "^15.15.0",
    "lovable-tagger": "^1.2.0",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.0.16",
    "vitest": "5.0.1",
    "wrangler": "^4.127.1"
  },
  "name": "custom_design_system_tanstack",
  "overrides": {
    "recharts": {
      "react-is": "$react"
    }
  },
  "packageManager": "npm@10.9.8",
  "private": true,
  "scripts": {
    "build": "node scripts/quality-gate.mjs && node scripts/predeploy-freshness.mjs && vite build",
    "build:dev": "node scripts/quality-gate.mjs && vite build --mode development",
    "cf-typegen": "wrangler types",
    "check:artifact-freshness": "node scripts/check-artifact-freshness.mjs",
    "check:artifacts": "node scripts/check-shared-artifacts.mjs",
    "check:contract": "node scripts/check-contract-drift.mjs",
    "check:contract-literals": "node scripts/check-contract-literals.mjs",
    "check:lockfiles": "node scripts/check-lockfiles.mjs",
    "check:ops-assistant": "node scripts/check-ops-assistant.mjs",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:version": "npm run build && wrangler versions upload",
    "dev": "vite dev",
    "gate": "node scripts/quality-gate.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:artifacts": "node scripts/sync-shared-artifacts.mjs",
    "sync:contract": "node scripts/sync-contract-source.mjs",
    "sync:shared-artifacts": "node scripts/sync-shared-artifacts.mjs",
    "test": "vitest run",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module"
}
